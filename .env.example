# Supabase (projeto qlswjefuinhbtlhauhgj - banco compartilhado com o ERP e o agente de atendimento)
SUPA_URL=https://qlswjefuinhbtlhauhgj.supabase.co
SUPA_SERVICE_KEY=

# Supabase separado, usado SÓ pela demo de prospecção (/demo, /api/disparar-demo)
# - nunca escreve nada no banco real do Chapelão
DEMO_SUPA_URL=
DEMO_SUPA_SERVICE_KEY=

# Evolution API (mesma instância usada pelo agente-chapelao)
EVOLUTION_URL=
EVOLUTION_KEY=
EVOLUTION_INSTANCE=

# OpenAI (geração das mensagens de recompra)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ElevenLabs (opcional - TTS do texto gerado em áudio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Senha simples pra proteger o painel (login básico, sem cadastro de usuário)
PANEL_PASSWORD=

# Token do endpoint /api/campanha, chamado pelo pg_cron do Supabase. Essa rota
# fica fora da senha do painel, então sem este valor ela recusa tudo.
CRON_SECRET=
